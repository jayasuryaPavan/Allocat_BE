# Allocat ERP Backend - Environment Configuration
# Copy this file to .env and fill in your values

# Cloud SQL Development Configuration
CLOUDSQL_DB_USER=allocat_user
CLOUDSQL_DB_PASSWORD=${CLOUDSQL_DB_PASSWORD}

# Spring Profile (use 'dev' for shared Cloud SQL, default uses local postgres)
SPRING_PROFILES_ACTIVE=dev

# Optional: GCP Project (for Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=allocat-481117
